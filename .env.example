# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Telegram Chat ID to send notifications to (use @userinfobot to get yours)
TELEGRAM_CHAT_ID=your_chat_id

# NewsAPI key (get free key at https://newsapi.org)
NEWS_API_KEY=your_newsapi_key

# Anthropic API key (for Claude summaries)
ANTHROPIC_API_KEY=your_anthropic_api_key

# News polling interval in minutes (default: 30)
POLL_INTERVAL_MINUTES=30

# News category: business, entertainment, general, health, science, sports, technology
NEWS_CATEGORY=technology

# News language: ru, en, de, fr, etc.
NEWS_LANGUAGE=ru

# Country for news: ru, us, gb, etc. (leave empty to disable)
NEWS_COUNTRY=ru
