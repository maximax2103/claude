# ── Polymarket Credentials (required for live trading) ──────────────────────
POLYMARKET_PRIVATE_KEY=
POLYMARKET_PROXY_WALLET=0xYourProxyWalletAddress
USE_PROXY_WALLET=true
SIGNATURE_TYPE=1   # 0=EOA  1=Proxy/Magic  2=Gnosis Safe

# ── Trading Thresholds ───────────────────────────────────────────────────────
MIN_EDGE=0.08               # Minimum probability edge to open a position (8%)
MIN_HOURS_TO_RESOLUTION=6   # Don't trade markets expiring in < 6 hours
MAX_HOURS_TO_RESOLUTION=168 # Don't trade markets > 7 days out
MAX_TRADES_PER_RUN=8        # Maximum new positions per bot run

# ── Position Sizing (Fractional Kelly) ───────────────────────────────────────
KELLY_FRACTION=0.25         # Quarter-Kelly (conservative)
MAX_POSITION_PCT=0.10       # Hard cap: max 10% of bankroll per trade
MIN_POSITION_USD=1.0        # Don't bother with positions under $1
MIN_BALANCE_USD=20.0        # Pause trading if balance drops below this

# ── Ensemble Forecast Parameters ────────────────────────────────────────────
NWS_MAE_F=3.2               # NWS historical mean absolute error (°F)
OPENMETEO_MAE_F=2.8         # Open-Meteo historical MAE (°F)
MIN_SIGMA_F=2.0             # Minimum uncertainty floor (°F)

# ── Locations (comma-separated, see config.py CITIES for valid keys) ─────────
LOCATIONS=nyc,chicago,miami,dallas,seattle,atlanta,losangeles,denver,phoenix,boston

# ── Simulation ───────────────────────────────────────────────────────────────
STARTING_BALANCE=1000.0
